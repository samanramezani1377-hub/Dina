# Dina backend configuration. Copy to .env and fill in real values.
# NEVER commit a real .env, key or certificate. Placeholders only.

ENVIRONMENT=production
SECRET_KEY=replace-me-with-a-long-random-value
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
DATABASE_URL=postgresql+psycopg://dina:change-me@localhost:5432/dina

# SaaS webhook authentication secret. Generate a random value; never commit the real secret.
PAYMENT_WEBHOOK_SECRET=

# ZarinPal REST v4.
# Merchant ID is not a password, but keep deployment-specific configuration out of source control.
ZARINPAL_MERCHANT_ID=
# Public HTTPS callback endpoint, for example:
# https://api.example.com/api/v1/payments/zarinpal/callback
ZARINPAL_CALLBACK_URL=
# true only for ZarinPal sandbox.
ZARINPAL_SANDBOX=false
ZARINPAL_TIMEOUT_SECONDS=15
