# Dina backend configuration. Copy to .env and fill in real values.
# NEVER commit a real .env, key or certificate. Placeholders only.

# "production", "staging", "development" or "test".
# Only "test" tolerates a missing SECRET_KEY (it gets a random per-process one).
ENVIRONMENT=production

# Signing key for JWTs. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required outside test environments; the app refuses to start without it.
SECRET_KEY=replace-me-with-a-long-random-value

# Token algorithm and lifetime. Algorithm must be one of HS256, HS384, HS512.
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# PostgreSQL connection string. Use a real secret manager or CI secret in
# deployments; never commit credentials.
DATABASE_URL=postgresql+psycopg://dina:change-me@localhost:5432/dina