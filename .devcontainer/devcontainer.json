{
  "name": "Dina Codespace Test Environment",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Dina Backend API",
      "protocol": "https",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "bash scripts/codespace_start.sh",
  "customizations": {
    "codespaces": {
      "openFiles": ["docs/CODESPACES_TEST.md"]
    }
  }
}
